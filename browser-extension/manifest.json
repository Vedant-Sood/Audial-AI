{
  "manifest_version": 3,
  "name": "Audial-AI · local tabs, captions and ISL",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Choose real browser tabs, send their audio to the local Audial-AI app, and display page text in ISL.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Audial-AI · choose this tab",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Choose the current tab in Audial-AI"
    }
  }
}
